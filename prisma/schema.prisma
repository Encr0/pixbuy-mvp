generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  password      String?   // Para login manual
  role          Role      @default(USER)
  orders        Order[]
  tickets       Ticket[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Product {
  id          String      @id @default(cuid())
  title       String
  description String
  coverImage  String
  priceCLP    Int
  priceUSD    Float
  platforms   String[]    // Ej: ["Steam", "Epic", "PSN"]
  publisher   String?
  isActive    Boolean     @default(true)
  keys        GameKey[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model GameKey {
  id        String    @id @default(cuid())
  keyString String    @unique // La clave real, ej: AAAA-BBBB-CCCC
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  status    KeyStatus @default(AVAILABLE)
  orderId   String?   // Se asigna cuando se vende
  order     Order?    @relation(fields: [orderId], references: [id])
}

enum KeyStatus {
  AVAILABLE
  SOLD
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  totalCLP  Int
  totalUSD  Float
  status    OrderStatus @default(PENDING)
  payment   String      // "Webpay" o "PayPal"
  items     OrderItem[]
  gameKeys  GameKey[]   // Las claves entregadas en esta orden
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // Precio al momento de la compra
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

enum TicketStatus {
  OPEN
  RESOLVED
}